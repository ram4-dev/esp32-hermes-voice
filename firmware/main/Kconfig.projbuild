menu "ESP32 Voice Agent"

config VOICE_WIFI_PRIMARY_SSID
    string "Primary Wi-Fi SSID"
    default "Ramiro-2.4Ghz"
    help
        Configure in sdkconfig.defaults.local. Never commit the local value.

config VOICE_WIFI_PRIMARY_PASSWORD
    string "Primary Wi-Fi password"
    default ""

config VOICE_WIFI_SECONDARY_SSID
    string "Fallback Wi-Fi SSID"
    default "Rama"

config VOICE_WIFI_SECONDARY_PASSWORD
    string "Fallback Wi-Fi password"
    default ""

config VOICE_BRIDGE_URL
    string "Voice bridge base URL"
    default "https://hermes-server.tailfb789f.ts.net:8443"
    help
        The official remote endpoint. A LAN URL may be supplied only in a local
        sdkconfig override for development.

config VOICE_DEVICE_ID
    string "Device ID"
    default "esp32-voice-01"

config VOICE_DEVICE_TOKEN
    string "Device bearer token"
    default ""
    help
        Configure locally; never commit or log a real token.

config VOICE_BRIDGE_EMBED_LOCAL_CA
    bool "Embed a private/local root CA"
    default n
    help
        Enable for a private PKI. The public Tailscale Funnel endpoint uses the
        ESP-IDF certificate bundle by default.

config VOICE_MAX_RECORDING_SECONDS
    int "Maximum recording duration"
    range 1 30
    default 30

config VOICE_POLL_TIMEOUT_SECONDS
    int "Maximum time to wait for STT, Hermes, and speech"
    range 30 600
    default 180

config VOICE_AUDIO_VOLUME
    int "Initial speaker volume"
    range 0 100
    default 65
    help
        Initial value only. The button persists the current volume in NVS.

endmenu
