# Device-facing authentication. Add more devices separated by commas.
VOICE_DEVICE_TOKENS=esp32-voice-01:replace-with-a-long-random-token
VOICE_DATA_DIR=/data
VOICE_MAX_AUDIO_BYTES=1100000
VOICE_MAX_AUDIO_SECONDS=30
VOICE_DISPLAY_ANSWER_CHARS=1200
VOICE_UPSTREAM_TIMEOUT_SECONDS=180

# OpenAI-compatible speech-to-text endpoint.
STT_BASE_URL=https://stt.example.local
STT_API_KEY=replace-me
STT_MODEL=whisper-1
STT_LANGUAGE=es

# Hermes Agent API server (API_SERVER_ENABLED=true).
HERMES_BASE_URL=http://hermes:8642
HERMES_API_KEY=replace-me
HERMES_MODEL=hermes-agent
